{
  "typescript.tsdk": "node_modules/typescript/lib",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "*.ts": "typescript"
  },
  "editor.tabSize": 2,
  "editor.wordWrapColumn": 100,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  },
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "prettier.singleQuote": true,
  "prettier.semi": false,
  "peacock.color": "#ffc324",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#ffd157",
    "activityBar.background": "#ffd157",
    "activityBar.foreground": "#15202b",
    "activityBar.inactiveForeground": "#15202b99",
    "activityBarBadge.background": "#009f74",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#15202b99",
    "sash.hoverBorder": "#ffd157",
    "statusBar.background": "#ffc324",
    "statusBar.foreground": "#15202b",
    "statusBarItem.hoverBackground": "#f0ae00",
    "statusBarItem.remoteBackground": "#009f74",
    "statusBarItem.remoteForeground": "#15202b",
    "titleBar.activeBackground": "#ffc324",
    "titleBar.activeForeground": "#15202b",
    "titleBar.inactiveBackground": "#ffc32499",
    "titleBar.inactiveForeground": "#15202b99",
    "activityBar.activeBorder": "#15202b",
    "activityBarTop.activeBackground": "#ffd157",
    "activityBarTop.activeBorder": "#15202b",
    "activityBarTop.background": "#ffd157",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.foreground": "#15202b",
    "statusBar.debuggingBackground": "#ffc324",
    "statusBar.debuggingForeground": "#15202b",
    "statusBar.inactiveBackground": "#ffc324"
  }
}
