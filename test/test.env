CLOUDINARY_API_KEY=test
CLOUDINARY_API_SECRET=test
MAILER_EMAIL_ADDRESS=test@test.local
MAILER_APP_PASSWORD=test
MAILER_TRANSPORT=log
OPENWEATHER_API_KEY=test
APP_URL=https://app.test
